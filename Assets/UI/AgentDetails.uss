:root {
    color: rgb(225, 225, 225);
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-Regular.ttf?fileID=12800000&guid=60b490663dafb4f2ca96da27cf91113f&type=3#Inter_18pt-Regular");
}

.fw-semi-bold {
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-SemiBold.ttf?fileID=12800000&guid=8889e09d56e434aefb734f5e13e2792e&type=3#Inter_18pt-SemiBold");
}

.fw-medium {
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-Medium.ttf?fileID=12800000&guid=83b55dee71047464eb402cf0013f7552&type=3#Inter_18pt-Medium");
}

.fw-bold {
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-Bold.ttf?fileID=12800000&guid=af77ddcd6bd904ed8ad3e1ebab4a0056&type=3#Inter_18pt-Bold");
}

.unity-label {
    margin: 0;
    padding: 0;
}

.drawer {
    width: 25%;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
}

#DetailPanel {
    border-radius: 10px 0 0 10px;
    background-color: rgba(0, 0, 0, 0.98);
    height: 100%;
    width: 30%;
    align-self: flex-end;
}

.wrapper {
    padding: 15px;
}

.icon-btn {
    background-color: transparent;
    margin: 0;
    width: 30px;
    height: 30px;
    aspect-ratio: 1;
    font-size: 18px;
    border-radius: 5px;
    padding: 2px;
    border-width: 0px;

    /* border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; */
}

.close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
}

.agent-details {
    font-size: 20px;
    align-items: auto;
    align-content: auto;
    width: 100%;
    white-space: normal;
}

.AgentIcon {
    position: relative;
    width: 40px;
    height: 40px;
    margin-right: 10px;
}

.AgentIcon #ring,
.AgentIcon #triangle {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.AgentIcon #triangle {
    scale: 0.8;
}

.TopContainer {
    display: flex;
    flex-direction: row;
    margin-bottom: 10px;
    align-items: center;
}

#AgentPersonaName {
    font-size: 20px;
    margin-left: 10px;
}

.horizontal-divider {
    height: 2px;
    background-color: rgb(39, 39, 39);
    margin-top: 5px;
    margin-bottom: 5px;
}

.pills-holder {
    display: flex;
    flex-direction: row;
    padding-bottom: 10px;
    padding-top: 10px;
}

.pills {
    border-width: 1px;
    border-color: rgb(144, 144, 144);
    border-radius: 15px;
    flex-basis: auto;
    margin-right: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 12px;
    border-color: rgb(124, 124, 124);
    font-size: 14px;
}

.s-icon {
    width: 12px;
    height: 12px;
    margin-right: 8px;
    background-color: rgb(76, 175, 80);
    border-radius: 50%;
}

.money-stats {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
    background-color: red;
    border-radius: 6px;
    background-color: rgba(53, 53, 53, 0.66);
    margin-bottom: 10px;
    margin-top: 15px;
}

.label-value-box {
    flex: 0 0 50%;
    padding-bottom: 10px;
}

.label-value-box .lv-label {
    font-size: 12px;
    margin-bottom: 6px;
}

.label-value-box .lv-value {
    font-size: 14px;
}

.unity-progress-bar {
    flex: 0 0 100%;
    margin: 0;
    height: 14px;
}

.unity-progress-bar__container {
    min-height: 14px;
}

.unity-progress-bar__background {
    background-color: white;
    border-radius: 4px;
    padding: 0;
}

.unity-progress-bar__progress {
    background-color: rgb(0, 230, 118);
    border-radius: 3px;
    margin: 0;
}

.text-right {
    align-items: flex-end;
}

.details-holder {
    margin-top: 10px;
}

.detail-value-box {
    margin-bottom: 15px;
}

.personal-details {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.personal-details .detail-value-box {
    flex: 0 0 50%;
    margin-bottom: 15px;
}

.item-label {
    font-size: 12px;
    color: rgb(144, 144, 144);
    margin-bottom: 6px;
}

.history-box {
    flex-grow: 1;
    margin-top: 15px;
}

.history-item {
    display: flex;
    flex-direction: column;
    padding: 10px 0;
    border-color: rgb(26, 26, 26);
    border-bottom-width: 1px 0;
}

.history-item:hover {
    background-color: transparent;
}

.history-item .history-item-description {
    white-space: normal;
    margin-bottom: 4px;
    margin-top: 4px;
    color: rgb(201, 201, 201);
}

.history-item .s-pill {
    width: auto;
    padding: 4px 10px;
    font-size: 12px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgb(124, 124, 124);
    border-radius: 12px;
}

.history-item .history-item-header {
    margin-bottom: 6px;
}

.history-item .history-item-timestamp {
    font-size: 12px;
    color: rgb(144, 144, 144);
}

.d-flex {
    display: flex;
    flex-direction: row;
}

.align-items-center {
    align-items: center;
}

.justify-content-between {
    justify-content: space-between;
}

.my-custom-scroll .unity-scroller--vertical {
    width: 8px;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.my-custom-scroll .unity-scroller__low-button,
.my-custom-scroll .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    height: 0;
    width: 0;
}

.my-custom-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.my-custom-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    border-width: 0;
    left: 0;
    width: 6px;
    align-self: center;
    min-height: 20px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.my-custom-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.45);
    width: 8px;
}

.my-custom-scroll .unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: rgba(255, 255, 255, 0.6);
}

.my-custom-scroll .unity-scroller--vertical:hover .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
}

.unity-list-view__item:hover {
    background-color: transparent;
}

.white-space-normal {
    white-space: normal;
}

.world-settings {
    display: flex;
  
    height: auto;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background-color: rgb(22, 25, 32);
    border-radius: 10px;
    padding: 20px;
    width: 500px;
}

.intial-settings{
    width: 1000px;
      flex-direction: row;
   
}

.world-settings .close-btn{
    top:10px;
    right:12px;
}

.world-settings .left-sec {
    align-items: center;
    justify-content: center;
    flex-basis: 50%;
    padding-right: 20px;
}

.world-settings .right-sec {
    display: flex;
    flex-basis: 50%;
}



.ws-logo {
    height: auto;
    width: 300px;
    aspect-ratio: 1;
    background-size: 300px auto;
}

.custom-enum-field {
    margin: 8px 4px;
    padding: 0;
    align-items: center;
}

.custom-enum-field > .unity-label {
    color: rgb(224, 224, 224);
    font-size: 14px;
}

.custom-enum-field > .unity-enum-field__input {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 12px;
    color: rgb(255, 255, 255);
    font-size: 13px;
}

.custom-enum-field > .unity-enum-field__input:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
}

.custom-enum-field .unity-enum-field__arrow {
    -unity-background-image-tint-color: rgb(224, 224, 224);
    width: 10px;
    height: 10px;
}

.custom-input-field {
    align-items: center;
    margin: 8px 4px;
    padding: 0;
}

.custom-input-field > .unity-integer-field__input {
    color: rgb(224, 224, 224);
    font-size: 14px;
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 4px;
    margin-left: 4px;
    padding: 6px 12px;
}

.box-header {
    font-size: 20px;
    margin-bottom: 10px;
}

.btn-primary {
    background-color: rgb(52, 211, 153);
    color: black;
    border-color: rgb(52, 211, 153);
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 8px;
    margin-top: 10px;
}

.navbar {
    padding: 10px 16px;
    font-size: 20px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.salesReport {
    position: absolute;
    top: 10%;
    right: 10%;
    left: 10%;
    bottom: 10%;
    background-color: rgba(0, 0, 0, 0.98);
    padding: 16px 0;
    border-radius: 10px;
}

.salesReportLabel {
    font-size: 20px;
    padding: 16px;
}

.sales-report-table-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 16px;
    border-bottom-width: 1px;
    border-color: rgb(26, 26, 26);
    border-style: solid;
    font-size: 16px;
}

.sales-report-table-header .sales-item-content {
    flex-basis: 20%;
    color: rgb(224, 224, 224);
}

.sales-item-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 16px;
    border-bottom-width: 1px;
    border-color: rgb(26, 26, 26);
    border-style: solid;
}

.sales-item-row .sales-item-content {
    flex-basis: 20%;
    -unity-text-align: middle-left;
}

.sales-report-table-header .sales-item-content.last,
.sales-item-row .sales-item-content.last {
    -unity-text-align: middle-right;
}

.sub-header {
    font-size: 16px;
    margin-top: 10px;
    margin-bottom: 5px;
}

.mb-16 {
    margin-bottom: 16px;
}
.mt-16 {
    margin-top: 16px;
}
.mt-8 {
    margin-top: 8px;
}
.mb-8 {
    margin-bottom: 8px;
}

.controls {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.controls .btn-icon {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 10px;
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.totalSales{
    font-size: 24px;
}