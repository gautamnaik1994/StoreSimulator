:root {
    color: rgb(225, 225, 225);
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-Regular.ttf");
}

.fw-semi-bold {
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-SemiBold.ttf");
}

.fw-medium {
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-Medium.ttf");
}

.fw-bold {
    -unity-font-definition: url("project://database/Assets/Fonts/Inter/Inter_18pt-Bold.ttf");
}


.unity-label {
    margin: 0;
    padding: 0;
}

.drawer {
    width: 25%;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
}

#DetailPanel {
    /* padding: 15px; */
    border-radius: 10px 0 0 10px;
    background-color: rgba(0, 0, 0, 0.98);
    height: 100%;
    width: 30%;
    align-self: flex-end;
}

.wrapper {

    padding: 15px;
}

.close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    height: 30px;
    background-color: transparent;
    font-size: 18px;
    border-radius: 5px;
    padding: 2px;
    width: 30px;
    aspect-ratio: 1;
    margin: 0;
}

.agent-details {
    font-size: 20px;
    align-items: auto;
    align-content: auto;
    width: 100%;
    white-space: normal;
}



.AgentIcon {
    position: relative;
    width: 40px;
    height: 40px;
    margin-right: 10px;
}

.AgentIcon #ring,
.AgentIcon #triangle {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

}



.AgentIcon #triangle {
    scale: 0.8;
}

.TopContainer {
    display: flex;
    flex-direction: row;
    margin-bottom: 10px;
    align-items: center;
}

#AgentPersonaName {
    font-size: 20px;
    margin-left: 10px;
}

.horizontal-divider {
    height: 2px;
    background-color: #272727;
    margin-top: 5px;
    margin-bottom: 5px;
}

.pills-holder {
    display: flex;
    flex-direction: row;
    padding-bottom: 10px;
    padding-top: 10px;
}

.pills {
    border-width: 1px;
    border-color: #909090;
    border-radius: 15px;
    flex-basis: auto;
    margin-right: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 12px;
    border-color: #7C7C7C;
    font-size: 14px;
}

.s-icon {
    width: 12px;
    height: 12px;
    margin-right: 8px;
    background-color: #4CAF50;
    border-radius: 50%;
}



.money-stats {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
    background-color: red;
    border-radius: 6px;
    background-color: rgba(53, 53, 53, 0.66);
    margin-bottom: 10px;
    margin-top: 15px;
}

.label-value-box {
    flex: 0 0 50%;
    padding-bottom: 10px;
}



.label-value-box .lv-label {

    font-size: 12px;
    margin-bottom: 6px;
}

.label-value-box .lv-value {
    /* padding:0;
    margin:0; */
    font-size: 14px;
}

.unity-progress-bar {
    flex: 0 0 100%;
    margin: 0px;
    height: 14px;
}

.unity-progress-bar__container {
    min-height: 14px;
}

.unity-progress-bar__background {
    background-color: white;
    border-radius: 4px;
    padding: 0;

}

.unity-progress-bar__progress {
    background-color: #00E676;
    border-radius: 3px;
    margin: 0;

}

.text-right {
    align-items: flex-end;
}

.details-holder {
    margin-top: 10px;
}

.detail-value-box {

    margin-bottom: 15px;
}

.personal-details {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.personal-details .detail-value-box {
    flex: 0 0 50%;
    margin-bottom: 15px;
}

.item-label {
    font-size: 12px;
    color: #909090;
    margin-bottom: 6px;
}

.history-box {
    flex-grow: 1;
    margin-top: 15px;
}

.history-item {
    display: flex;
    flex-direction: column;

    padding: 10px 0px;
    border-color: #1a1a1a;
    /* border-style: solid; */
    border-bottom-width: 1px 0px;
    /* background-color: #333333; */
}

.history-item:hover {
    background-color: transparent;
}

.history-item .history-item-description {


    white-space: normal;
    margin-bottom: 4px;
    margin-top: 4px;
    color: rgb(201, 201, 201);
    /* -unity-paragraph-spacing:100px; */
}

.history-item .s-pill {
    width: auto;
    padding: 4px 10px;
    font-size: 12px;
    margin-right: 8px;
    border-width: 1px;
    border-color: #7C7C7C;
    border-radius: 12px;

}

.history-item .history-item-header {
    margin-bottom: 6px;
}

.history-item .history-item-timestamp {
    font-size: 12px;
    color: #909090;
}

.d-flex {
    display: flex;
    flex-direction: row;
}

.align-items-center {
    align-items: center;
}

.justify-content-between {
    justify-content: space-between;
}

/* ==========================================
   macOS Dark Mode Scrollbar for UI Toolkit
   ========================================== */

/* 1. Container & Scroller Track Layout */
.my-custom-scroll .unity-scroller--vertical {
    width: 8px;
    /* macOS scrollbars are quite thin */
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

/* 2. Hide the top and bottom arrow buttons entirely */
.my-custom-scroll .unity-scroller__low-button,
.my-custom-scroll .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    height: 0;
    width: 0;
}

/* 3. Style the background track line (Slider Container) */
.my-custom-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    /* macOS hides the track by default */
    border-width: 0;
    margin: 0;
    padding: 0;
}

/* 4. The Draggable Handle (The Capsule) */
.my-custom-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    /* macOS dark scrollbar color with transparency */
    background-color: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    /* Fully rounded capsule look */
    border-width: 0;

    /* Crucial for UI Toolkit alignment quirks */
    left: 0;
    width: 6px;
    align-self: center;

    min-height: 20px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

/* 5. Hover and Active States */
.my-custom-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.45);
    /* Becomes more visible on hover */
    width: 8px;
    /* Optional: slightly widens on hover like modern macOS */
}

/* When the user is actively dragging it */
.my-custom-scroll .unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: rgba(255, 255, 255, 0.6);
}

/* Optional: Show a subtle track background only when hovering over the whole scroller area */
.my-custom-scroll .unity-scroller--vertical:hover .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
}

.unity-list-view__item:hover {
    background-color: transparent;
}

.white-space-normal {
    white-space: normal;
}

.world-settings {
    width: 400px;
    height: auto;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background-color: rgba(0, 0, 0, 0.98);
    border-radius: 10px;
    padding: 20px;
}

.custom-enum-field {
    margin: 8px 4px;
    padding: 0px;
    align-items: center;
}

/* 2. Style the Label text on the left */
.custom-enum-field>.unity-label {
    color: #E0E0E0;
    /* Off-white text for readability */
    font-size: 14px;
    /* -unity-font-style: bold; */
    /* min-width: 120px; Aligns label nicely */
}

/* 3. Style the actual Dropdown Button box */
.custom-enum-field>.unity-enum-field__input {
    background-color: rgba(255, 255, 255, 0.05);
    /* Subtle translucent white layer */
    border-color: rgba(255, 255, 255, 0.15);
    /* Subtle border line */
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 12px;
    color: #FFFFFF;
    /* High contrast text inside dropdown */
    font-size: 13px;
}

/* 4. Hover effect for the Dropdown Box */
.custom-enum-field>.unity-enum-field__input:hover {
    background-color: rgba(255, 255, 255, 0.1);
    /* Brightens slightly on hover */
    border-color: rgba(255, 255, 255, 0.3);
    /* Highlights border */
}

/* 5. Style the internal Arrow icon */
.custom-enum-field .unity-enum-field__arrow {
    -unity-background-image-tint-color: #E0E0E0;
    /* Makes the arrow icon clean white */
    width: 10px;
    height: 10px;
}

.box-header {
    font-size: 20px;
    margin-bottom: 10px;
}

.btn-primary {
    background-color: #34D399;
    color: black;
    border-color: #34D399;
    padding: 10px 20px;
    font-size: 16px;

    border-radius: 8px;
    margin-top: 20px;
}

.navbar {
    padding: 16px 8px;
    font-size: 20px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
}


.salesReport {
    position: absolute;
    top: 10%;
    right: 10%;
    left: 10%;
    bottom: 10%;
    background-color: rgba(0, 0, 0, 0.98);
    padding: 16px 0px;
    border-radius: 10px;
}

.salesReportLabel {
    font-size: 20px;
    /* margin-bottom: 10px; */
    padding: 16px;
}

.sales-report-table-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 16px;
    border-bottom-width: 1px;
    border-color: #1a1a1a;
    border-style: solid;
    font-size: 16px;
    /*
   
    align-items: flex-start; */

}

.sales-report-table-header .sales-item-content {
    flex-basis: 20%;
    color: #E0E0E0;
}

.sales-item-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 16px;

    border-bottom-width: 1px;
    border-color: #1a1a1a;
    border-style: solid;

}

.sales-item-row .sales-item-content {
    flex-basis: 20%;
    -unity-text-align: middle-left;
}

.sales-report-table-header .sales-item-content.last,
.sales-item-row .sales-item-content.last {
    -unity-text-align: middle-right;
}
